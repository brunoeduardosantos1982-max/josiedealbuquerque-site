# leves em public/video/, gerados por ffmpeg (ver AGENTS.md).
/materiais-src/videos/
/materiais-src/fotos/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.vercel
